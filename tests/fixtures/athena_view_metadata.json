    "definition": {
      "originalSql": "WITH\n  __dbt__cte__stg_building_proximity AS (\n   SELECT\n     building_id\n   , park_id\n   , distance_m\n   , within_threshold\n   , grid_id\n   , source_release\n   , area_id\n   , 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' source_run_sha256\n   FROM\n     \"awsdatacatalog\".\"urban_geo_test_m4\".\"building_proximity\" FOR VERSION AS OF 123\n) \n, counts AS (\n   SELECT\n     source_release\n   , area_id\n   , source_run_sha256\n   , grid_id\n   , COUNT(*) mapped_buildings\n   , SUM((CASE WHEN within_threshold THEN 1 ELSE 0 END)) buildings_within\n   FROM\n     __dbt__cte__stg_building_proximity\n   GROUP BY source_release, area_id, source_run_sha256, grid_id\n) \nSELECT\n  *\n, (CAST(buildings_within AS DOUBLE) / mapped_buildings) share_within\nFROM\n  counts\nORDER BY source_release ASC, area_id ASC, grid_id ASC\n",
